{
  "author": "swapkit",
  "description": "SwapKit - Cardano wallet extensions",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/types/index.d.ts"
    },
    "./cip8": {
      "bun": "./src/cip8.ts",
      "import": "./dist/cip8.js",
      "require": "./dist/cip8.cjs",
      "types": "./dist/types/cip8.d.ts"
    },
    "./cip30": {
      "bun": "./src/cip30.ts",
      "import": "./dist/cip30.js",
      "require": "./dist/cip30.cjs",
      "types": "./dist/types/cip30.d.ts"
    },
    "./cip45": {
      "bun": "./src/cip45.ts",
      "import": "./dist/cip45.js",
      "require": "./dist/cip45.cjs",
      "types": "./dist/types/cip45.d.ts"
    },
    "./cip158": {
      "bun": "./src/cip158.ts",
      "import": "./dist/cip158.js",
      "require": "./dist/cip158.cjs",
      "types": "./dist/types/cip158.d.ts"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "homepage": "https://github.com/swapkit/wallets",
  "license": "SEE LICENSE IN LICENSE",
  "name": "@swapkit/cardano-extensions",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/cardano-extensions",
    "type": "git",
    "url": "git+https://github.com/swapkit/wallets.git"
  },
  "scripts": {
    "build": "bun run ./build.ts",
    "build:clean": "rm -rf dist && bun run ./build.ts",
    "clean": "rm -rf dist node_modules *.tsbuildinfo",
    "type-check": "bun tsc --noEmit",
    "type-check:go": "tsgo"
  },
  "type": "module",
  "version": "0.1.0"
}
